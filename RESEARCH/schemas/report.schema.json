{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argo.local/research/report-0.1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "lane": {
      "enum": [
        "R1",
        "R2",
        "R3",
        "R4",
        "R5"
      ]
    },
    "status": {
      "enum": [
        "starter",
        "complete",
        "blocked"
      ]
    },
    "base_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "requested_model": {
      "enum": [
        "grok-4.3",
        "grok-4.7"
      ]
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "codex_starter",
            "vendor_run"
          ]
        },
        "executed_model": {
          "type": [
            "string",
            "null"
          ]
        },
        "paid_run": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "executed_model",
        "paid_run"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "edition": {
            "type": "string",
            "minLength": 1
          },
          "accessed_on": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "retrieval": {
            "enum": [
              "primary_page",
              "primary_work_mirror",
              "secondary_page",
              "search_excerpt",
              "unavailable"
            ]
          },
          "locator": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "title",
          "url",
          "edition",
          "accessed_on",
          "retrieval",
          "locator"
        ]
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "basis": {
            "enum": [
              "documented",
              "design_inference",
              "hypothesis"
            ]
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "statement",
          "basis",
          "source_ids"
        ]
      }
    },
    "proposals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "targets": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "SYSTEMS",
                "MECHANICS",
                "TESTS"
              ]
            }
          },
          "compatibility": {
            "enum": [
              "current_v1",
              "new_workflow",
              "versioned_migration"
            ]
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "type": "string",
                  "minLength": 1
                },
                "visibility": {
                  "enum": [
                    "authority",
                    "actor_scoped",
                    "session_only",
                    "research_only"
                  ]
                },
                "meaning": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "name",
                "type",
                "visibility",
                "meaning"
              ]
            }
          },
          "rules": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "title",
          "targets",
          "compatibility",
          "source_ids",
          "fields",
          "rules"
        ]
      }
    },
    "benchmarks": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "existing_source_assertion",
              "proposed"
            ]
          },
          "coverage_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "given": {
            "type": "string",
            "minLength": 1
          },
          "when": {
            "type": "string",
            "minLength": 1
          },
          "then": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "oracle": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "title",
          "status",
          "coverage_path",
          "given",
          "when",
          "then",
          "oracle"
        ]
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema_version",
    "lane",
    "status",
    "base_commit",
    "requested_model",
    "producer",
    "title",
    "summary",
    "sources",
    "claims",
    "proposals",
    "benchmarks",
    "open_questions"
  ]
}
