{
  "name": "argo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "npm@11.9.0",
  "workspaces": [
    "packages/*",
    "scenarios/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test TESTS/*.test.ts",
    "contracts": "python3 scripts/generate-contract-types.py --check && node scripts/check-contracts.mjs",
    "gate": "node scripts/gate.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "24.10.1"
  },
  "dependencies": {
    "ajv": "8.17.1"
  }
}
