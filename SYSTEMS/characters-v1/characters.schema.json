{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argo.local/contracts/character-memory/1.0.0/characters.schema.json",
  "$defs": {
    "CharacterCursor": {
      "type": "object",
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "head": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "world_time": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "sequence",
        "head",
        "world_time"
      ],
      "additionalProperties": false
    },
    "CharacterNature": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "priorities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "minItems": 0,
          "maxItems": 16,
          "uniqueItems": true
        }
      },
      "required": [
        "description",
        "priorities"
      ],
      "additionalProperties": false
    },
    "CharacterActivity": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "busy_until": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "description",
        "busy_until"
      ],
      "additionalProperties": false
    },
    "CharacterSpeechPolicy": {
      "type": "object",
      "properties": {
        "max_characters": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "minimum_interval": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "max_characters",
        "minimum_interval"
      ],
      "additionalProperties": false
    },
    "CharacterProfile": {
      "type": "object",
      "properties": {
        "actor_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "nature": {
          "$ref": "#/$defs/CharacterNature"
        },
        "activity": {
          "$ref": "#/$defs/CharacterActivity"
        },
        "speech_policy": {
          "$ref": "#/$defs/CharacterSpeechPolicy"
        }
      },
      "required": [
        "actor_id",
        "revision",
        "nature",
        "activity",
        "speech_policy"
      ],
      "additionalProperties": false
    },
    "CharacterWitnessGrant": {
      "type": "object",
      "properties": {
        "request_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "actor_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
          },
          "minItems": 0,
          "maxItems": 64,
          "uniqueItems": true
        },
        "party_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "request_hash",
        "actor_ids",
        "party_id"
      ],
      "additionalProperties": false
    },
    "CharacterConfigure": {
      "type": "object",
      "properties": {
        "type": {
          "const": "configure"
        },
        "profile": {
          "$ref": "#/$defs/CharacterProfile"
        }
      },
      "required": [
        "type",
        "profile"
      ],
      "additionalProperties": false
    },
    "CharacterSpeak": {
      "type": "object",
      "properties": {
        "type": {
          "const": "speak"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "addressed_actor_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
          },
          "minItems": 0,
          "maxItems": 64,
          "uniqueItems": true
        }
      },
      "required": [
        "type",
        "text",
        "addressed_actor_ids"
      ],
      "additionalProperties": false
    },
    "CharacterWitnessAction": {
      "type": "object",
      "properties": {
        "type": {
          "const": "witness_action"
        },
        "record_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "type",
        "record_id"
      ],
      "additionalProperties": false
    },
    "CharacterFormImpression": {
      "type": "object",
      "properties": {
        "type": {
          "const": "form_impression"
        },
        "subject_actor_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true
        },
        "interpretation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "previous_impression_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "subject_actor_id",
        "evidence_ids",
        "interpretation",
        "previous_impression_id"
      ],
      "additionalProperties": false
    },
    "CharacterSetActivity": {
      "type": "object",
      "properties": {
        "type": {
          "const": "set_activity"
        },
        "activity": {
          "$ref": "#/$defs/CharacterActivity"
        }
      },
      "required": [
        "type",
        "activity"
      ],
      "additionalProperties": false
    },
    "CharacterCommandBody": {
      "oneOf": [
        {
          "$ref": "#/$defs/CharacterConfigure"
        },
        {
          "$ref": "#/$defs/CharacterSpeak"
        },
        {
          "$ref": "#/$defs/CharacterWitnessAction"
        },
        {
          "$ref": "#/$defs/CharacterFormImpression"
        },
        {
          "$ref": "#/$defs/CharacterSetActivity"
        }
      ]
    },
    "CharacterCommand": {
      "type": "object",
      "properties": {
        "version": {
          "const": "character-memory/1.0.0"
        },
        "scope": {
          "$ref": "https://argo.local/contracts/1.0.0/argo.schema.json#/$defs/Scope"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
        },
        "expected_cursor": {
          "$ref": "#/$defs/CharacterCursor"
        },
        "body": {
          "$ref": "#/$defs/CharacterCommandBody"
        }
      },
      "required": [
        "version",
        "scope",
        "request_id",
        "expected_cursor",
        "body"
      ],
      "additionalProperties": false
    },
    "CharacterRequester": {
      "type": "object",
      "properties": {
        "principal_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
        },
        "actor_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
        },
        "role": {
          "enum": [
            "player",
            "npc",
            "intervention",
            "system"
          ]
        }
      },
      "required": [
        "principal_id",
        "actor_id",
        "role"
      ],
      "additionalProperties": false
    },
    "CharacterImpressionData": {
      "type": "object",
      "properties": {
        "owner_actor_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
        },
        "subject_actor_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true
        },
        "nature_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "nature": {
          "$ref": "#/$defs/CharacterNature"
        },
        "interpretation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "previous_impression_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "owner_actor_id",
        "subject_actor_id",
        "evidence_ids",
        "nature_revision",
        "nature",
        "interpretation",
        "previous_impression_id"
      ],
      "additionalProperties": false
    },
    "CharacterConfigured": {
      "type": "object",
      "properties": {
        "type": {
          "const": "configure"
        },
        "profile": {
          "$ref": "#/$defs/CharacterProfile"
        }
      },
      "required": [
        "type",
        "profile"
      ],
      "additionalProperties": false
    },
    "CharacterSpoken": {
      "type": "object",
      "properties": {
        "type": {
          "const": "speak"
        },
        "actor_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "addressed_actor_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
          },
          "minItems": 0,
          "maxItems": 64,
          "uniqueItems": true
        },
        "witnesses": {
          "$ref": "#/$defs/CharacterWitnessGrant"
        }
      },
      "required": [
        "type",
        "actor_id",
        "text",
        "addressed_actor_ids",
        "witnesses"
      ],
      "additionalProperties": false
    },
    "CharacterActionWitnessed": {
      "type": "object",
      "properties": {
        "type": {
          "const": "witness_action"
        },
        "record_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "witnesses": {
          "$ref": "#/$defs/CharacterWitnessGrant"
        }
      },
      "required": [
        "type",
        "record_id",
        "witnesses"
      ],
      "additionalProperties": false
    },
    "CharacterImpressionFormed": {
      "type": "object",
      "properties": {
        "type": {
          "const": "form_impression"
        },
        "data": {
          "$ref": "#/$defs/CharacterImpressionData"
        }
      },
      "required": [
        "type",
        "data"
      ],
      "additionalProperties": false
    },
    "CharacterActivitySet": {
      "type": "object",
      "properties": {
        "type": {
          "const": "set_activity"
        },
        "actor_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
        },
        "activity": {
          "$ref": "#/$defs/CharacterActivity"
        }
      },
      "required": [
        "type",
        "actor_id",
        "activity"
      ],
      "additionalProperties": false
    },
    "CharacterEnvelopeBody": {
      "oneOf": [
        {
          "$ref": "#/$defs/CharacterConfigured"
        },
        {
          "$ref": "#/$defs/CharacterSpoken"
        },
        {
          "$ref": "#/$defs/CharacterActionWitnessed"
        },
        {
          "$ref": "#/$defs/CharacterImpressionFormed"
        },
        {
          "$ref": "#/$defs/CharacterActivitySet"
        }
      ]
    },
    "CharacterEnvelope": {
      "type": "object",
      "properties": {
        "version": {
          "const": "character-memory/1.0.0"
        },
        "scope": {
          "$ref": "https://argo.local/contracts/1.0.0/argo.schema.json#/$defs/Scope"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
        },
        "request_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "requester": {
          "$ref": "#/$defs/CharacterRequester"
        },
        "body": {
          "$ref": "#/$defs/CharacterEnvelopeBody"
        }
      },
      "required": [
        "version",
        "scope",
        "request_id",
        "request_hash",
        "requester",
        "body"
      ],
      "additionalProperties": false
    },
    "CharacterExperience": {
      "type": "object",
      "properties": {
        "record_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "kind": {
          "enum": [
            "speech",
            "action"
          ]
        },
        "actor_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
        },
        "principal_actor_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "world_time": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "action_type": {
          "anyOf": [
            {
              "enum": [
                "move_item",
                "record_consent",
                "revoke_consent",
                "transfer_time",
                "grant_proxy",
                "revoke_proxy",
                "vanish_thread",
                "name_anomaly",
                "end_thread"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "addressed_actor_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
          },
          "minItems": 0,
          "maxItems": 64,
          "uniqueItems": true
        }
      },
      "required": [
        "record_id",
        "kind",
        "actor_id",
        "principal_actor_id",
        "sequence",
        "world_time",
        "text",
        "action_type",
        "addressed_actor_ids"
      ],
      "additionalProperties": false
    },
    "CharacterAcquisition": {
      "type": "object",
      "properties": {
        "actor_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "world_time": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "party_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "actor_id",
        "sequence",
        "world_time",
        "party_id"
      ],
      "additionalProperties": false
    },
    "CharacterMemoryRecord": {
      "type": "object",
      "properties": {
        "experience": {
          "$ref": "#/$defs/CharacterExperience"
        },
        "acquisitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CharacterAcquisition"
          },
          "minItems": 0
        }
      },
      "required": [
        "experience",
        "acquisitions"
      ],
      "additionalProperties": false
    },
    "CharacterImpression": {
      "type": "object",
      "properties": {
        "impression_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "world_time": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "data": {
          "$ref": "#/$defs/CharacterImpressionData"
        }
      },
      "required": [
        "impression_id",
        "sequence",
        "world_time",
        "data"
      ],
      "additionalProperties": false
    },
    "CharacterActorState": {
      "type": "object",
      "properties": {
        "actor_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
        },
        "alive": {
          "type": "boolean"
        }
      },
      "required": [
        "actor_id",
        "alive"
      ],
      "additionalProperties": false
    },
    "CharacterParty": {
      "type": "object",
      "properties": {
        "party_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
        },
        "actor_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "party_id",
        "actor_ids"
      ],
      "additionalProperties": false
    },
    "CharacterProjection": {
      "type": "object",
      "properties": {
        "version": {
          "const": "character-memory/1.0.0"
        },
        "scope": {
          "$ref": "https://argo.local/contracts/1.0.0/argo.schema.json#/$defs/Scope"
        },
        "cursor": {
          "$ref": "#/$defs/CharacterCursor"
        },
        "activation_sequence": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "profiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CharacterProfile"
          },
          "minItems": 0
        },
        "actors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CharacterActorState"
          },
          "minItems": 0
        },
        "parties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CharacterParty"
          },
          "minItems": 0
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CharacterMemoryRecord"
          },
          "minItems": 0
        },
        "impressions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CharacterImpression"
          },
          "minItems": 0
        },
        "ontology_blocked": {
          "type": "boolean"
        },
        "engagement_closed": {
          "type": "boolean"
        }
      },
      "required": [
        "version",
        "scope",
        "cursor",
        "activation_sequence",
        "profiles",
        "actors",
        "parties",
        "records",
        "impressions",
        "ontology_blocked",
        "engagement_closed"
      ],
      "additionalProperties": false
    },
    "CharacterActorQuery": {
      "type": "object",
      "properties": {
        "version": {
          "const": "character-memory/1.0.0"
        },
        "scope": {
          "$ref": "https://argo.local/contracts/1.0.0/argo.schema.json#/$defs/Scope"
        },
        "cursor": {
          "$ref": "#/$defs/CharacterCursor"
        },
        "actor_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
        }
      },
      "required": [
        "version",
        "scope",
        "cursor",
        "actor_id"
      ],
      "additionalProperties": false
    },
    "CharacterView": {
      "type": "object",
      "properties": {
        "query": {
          "$ref": "#/$defs/CharacterActorQuery"
        },
        "profile": {
          "anyOf": [
            {
              "$ref": "#/$defs/CharacterProfile"
            },
            {
              "type": "null"
            }
          ]
        },
        "alive": {
          "type": "boolean"
        },
        "last_spoke_at": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "impressions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CharacterImpression"
          },
          "minItems": 0
        },
        "experiences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CharacterExperience"
          },
          "minItems": 0,
          "maxItems": 16
        },
        "ontology_blocked": {
          "type": "boolean"
        },
        "engagement_closed": {
          "type": "boolean"
        }
      },
      "required": [
        "query",
        "profile",
        "alive",
        "last_spoke_at",
        "impressions",
        "experiences",
        "ontology_blocked",
        "engagement_closed"
      ],
      "additionalProperties": false
    },
    "CharacterNarratorQuery": {
      "type": "object",
      "properties": {
        "version": {
          "const": "character-memory/1.0.0"
        },
        "scope": {
          "$ref": "https://argo.local/contracts/1.0.0/argo.schema.json#/$defs/Scope"
        },
        "cursor": {
          "$ref": "#/$defs/CharacterCursor"
        },
        "traveler_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
        },
        "actor_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
        },
        "audience": {
          "enum": [
            "actor",
            "party"
          ]
        },
        "party_id": {
